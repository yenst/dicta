{
  "name": "dicta",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build:web": "tsc && vite build",
    "build:mcp": "cargo build --release --manifest-path mcp/Cargo.toml",
    "build": "npm run build:web && npm run build:mcp",
    "bundle:linux": "bash scripts/package-linux.sh",
    "tauri": "tauri",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.8.3",
    "vite": "^7"
  }
}
